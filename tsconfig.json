{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src/skills",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/skills/project-skill/**/*.ts", "src/skills/character-skill/**/*.ts", "src/skills/world-skill/**/*.ts", "src/skills/outline-skill/**/*.ts", "src/skills/writing-skill/**/*.ts", "src/skills/context-engine/**/*.ts"]
}
