generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ========== 项目 ==========
model Project {
  id          String   @id @default(cuid())
  name        String
  subtitle    String   @default("")
  genre       String
  description String?
  theme       String   @default("")
  tags        String   @default("")
  cover       String   @default("")
  status      String   @default("筹备中")
  targetWords Int      @default(0)
  currentWords Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  characters     Character[]
  relationships  CharacterRelationship[]
  factions       Faction[]
  locations      Location[]
  ruleSystems    RuleSystem[]
  historyEvents  HistoryEvent[]
  volumes        Volume[]
  chapters       Chapter[]
  scenes         Scene[]
  futureScenes   FutureScene[]
  references     Reference[]
  generationLogs AIGenerationLog[]
  unifiedItems   UnifiedItem[]
  chatSessions   ChatSession[]
  projectMemories ProjectMemory[]
}

// ========== Story Bible: 人物 ==========
model Character {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  alias       String?
  gender      String   @default("未知")
  age         Int      @default(0)
  birthday    String   @default("")
  race        String   @default("人类")
  occupation  String   @default("")
  role        String
  factionId   String?
  faction     Faction? @relation(fields: [factionId], references: [id])
  personality String
  appearance    String?
  background    String?
  goal          String   @default("")
  motivation    String   @default("")
  arc           String?
  abilities     String?
  speakingStyle String   @default("")
  behaviorLogic String   @default("")
  forbidden     String   @default("")
  notes         String?
  tags          String?
  status        String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  relationshipsAsA CharacterRelationship[] @relation("CharA")
  relationshipsAsB CharacterRelationship[] @relation("CharB")

  @@unique([projectId, name])
}

// ========== Story Bible: 人物关系 ==========
model CharacterRelationship {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characterAId  String
  characterA    Character @relation("CharA", fields: [characterAId], references: [id], onDelete: Cascade)
  characterBId  String
  characterB    Character @relation("CharB", fields: [characterBId], references: [id], onDelete: Cascade)
  relationType  String
  description   String?
  createdAt     DateTime @default(now())
}

// ========== Story Bible: 势力 ==========
model Faction {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  type        String
  description String?
  influence   Int      @default(0)
  military    Int      @default(0)
  economy     Int      @default(0)
  resources   String?
  notes       String?
  tags        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     Character[]

  @@unique([projectId, name])
}

// ========== Story Bible: 地点 ==========
model Location {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  type        String
  parentId    String?
  parent      Location? @relation("LocationHierarchy", fields: [parentId], references: [id])
  children    Location[] @relation("LocationHierarchy")
  description String?
  climate     String?
  resources   String?
  notes       String?
  tags        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ========== Story Bible: 规则体系 ==========
model RuleSystem {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    String
  title       String
  content     String
  tags        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ========== Story Bible: 历史事件 ==========
model HistoryEvent {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  summary     String
  era         String?
  characters  String?
  factions    String?
  isAuto      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ========== Story Map: 卷 ==========
model Volume {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  summary   String?
  order     Int
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapters  Chapter[]
}

// ========== Story Map: 章 ==========
model Chapter {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  volumeId  String?
  volume    Volume?  @relation(fields: [volumeId], references: [id])
  title       String
  summary     String?
  autoSummary String?
  goal        String   @default("")
  content     String?
  wordCount   Int      @default(0)
  order       Int
  status      String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scenes              Scene[]
  futureSceneTriggers FutureScene[] @relation("FutureSceneTriggers")
  chatSessions        ChatSession[]
}

model ChatSession {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  title     String   @default("新对话")
  provider  String
  model     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  ChatMessage[]

  @@index([projectId, updatedAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())

  memories ProjectMemory[]
  @@index([sessionId, createdAt])
}

model ProjectMemory {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category        String   @default("其他")
  title           String
  content         String
  status          String   @default("active")
  sourceMessageId String?
  sourceMessage   ChatMessage? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId, status])
}

// ========== Story Map: 场景/情节点 ==========
model Scene {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id])
  title     String
  summary   String?
  goal      String   @default("")
  conflict  String   @default("")
  result    String   @default("")
  characterIds String @default("[]")
  locationIds  String @default("[]")
  factionIds   String @default("[]")
  tags         String @default("[]")
  order     Int
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== Future Scene: 未来场景库 ==========
model FutureScene {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String
  summary            String?
  emotionGoal        String?
  sceneType          String?
  importance         String   @default("medium")
  status             String   @default("构思中")
  triggerConditions  String?
  prerequisiteEvents String?
  targetCharacters   String?
  targetLocations    String?
  targetFactions     String?
  expectedChapterId  String?
  expectedChapter    Chapter? @relation("FutureSceneTriggers", fields: [expectedChapterId], references: [id])
  notes              String?
  tags               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ========== 参考资料库 ==========
model Reference {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  content   String
  category  String   @default("其他")
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== 统一知识条目（灵活存储，替代逐个类型建表） ==========
model UnifiedItem {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String   // character / faction / location / artifact / technique / rule / history_event / timeline_node / nation / sect
  name        String
  aliases     String   @default("")   // comma-separated
  summary     String   @default("")
  description String   @default("")
  tags        String   @default("")   // comma-separated
  attrsJson   String   @default("{}") // JSON blob for type-specific fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, type])
  @@index([projectId])
}

// ========== AI 生成日志 ==========
model AIGenerationLog {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  provider  String
  model     String
  prompt    String
  result    String
  accepted  Boolean  @default(false)
  tokenUsed Int
  targetType String?
  targetId  String?
  createdAt DateTime @default(now())
}
