# SQLite database used by Prisma
DATABASE_URL="file:./dev.db"

# Server-side AI provider. Supported: deepseek, kimi, claude
DEFAULT_AI_PROVIDER="deepseek"

# Provider credentials (never expose these to browser code)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL="deepseek-chat"
KIMI_API_KEY=
KIMI_MODEL="moonshot-v1-8k"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-sonnet-4-6"
